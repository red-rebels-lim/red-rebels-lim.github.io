{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "solosalamina-payload",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "routes": [
    // Admin dashboard at https://admin.red-rebels.com/admin — Cloudflare
    // manages the DNS record + cert for custom domains automatically.
    {
      "pattern": "admin.red-rebels.com",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "D1",
      // Local dev never touches remote: getPlatformProxy in payload.config.ts
      // only enables remoteBindings when NODE_ENV=production.
      "database_id": "05c8389c-dede-431e-bb1c-80551e8dceb8",
      "database_name": "solosalamina-data",
      "remote": true,
    },
  ],
  "services": [
    // The service must match the "name" of this worker
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "solosalamina-payload",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      // Bucket created by DATA-03 (`wrangler r2 bucket create solosalamina-media`).
      "bucket_name": "solosalamina-media",
    },
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "<BUCKET_NAME>",
    // },
  ],

  // Here's how to configure an additional environment
  // It can be deployed with `CLOUDFLARE_ENV=staging pnpm run deploy`
  // "env": {
  //   "staging": {
  //     "name": "my-app-staging",
  //     "d1_databases": [
  //       {
  //         "binding": "D1",
  //         "database_id": "DATABASE_ID",
  //         "database_name": "my-app-staging",
  //         "remote": true
  //       }
  //     ],
  //     "services": [
  //       // The service should match the "name" of your worker
  //       // {
  //       //   "binding": "WORKER_SELF_REFERENCE",
  //       //   "service": "my-app-staging"
  //       // },
  //     ],
  //     "r2_buckets": [
  //       {
  //         "binding": "R2",
  //         "bucket_name": "my-app-staging"
  //       }
  //       // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
  //       // {
  //       //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //       //   "bucket_name": "<BUCKET_NAME>",
  //       // },
  //     ]
  //   }
  // }
}
